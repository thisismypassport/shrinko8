--[[$lint: ps8_inst, ps8_val, ps8_binder]]function ps8_const(x) return function() return x end end

function ps8_decode(data)
	local pos = 0
	local function byte()
		pos += 1
		return ord(data, pos)
	end
	local function word()
		return byte() >>> 16 | byte() >>> 8 | byte() | byte() << 8
	end
	return function()
		local ctl = byte()
		local v, i = ctl&252 ~= 252 and ctl\4, ctl%4
		if (i == 1) return v and v-31 or word()
		if (i == 0) return ({true, false})[v]
		local len = v or word()<<16
		pos += len
		return sub(data, pos-len+1, pos)
	end
end

